# Copy to .env before running docker compose.
BOOK_POSTGRES_DB=mytruyen
BOOK_POSTGRES_USER=mytruyen
BOOK_POSTGRES_PASSWORD=change-me
BOOK_DB_POOL_SIZE=10
BOOK_DB_MAX_OVERFLOW=20

USER_POSTGRES_DB=mytruyen_users
USER_POSTGRES_USER=mytruyen
USER_POSTGRES_PASSWORD=change-me

# Base64 DER keys: PKCS#8 private key and X.509 SubjectPublicKeyInfo public key.
# Only auth-service receives the private key. Never commit a production key.
JWT_PRIVATE_KEY_BASE64=replace-with-base64-pkcs8-private-key
JWT_PUBLIC_KEY_BASE64=replace-with-base64-x509-public-key
JWT_EXPIRATION_MS=3600000
JWT_ALGORITHM=RS256
JWT_ISSUER=mytruyen-auth
JWT_AUDIENCE=mytruyen-api
INTERNAL_API_KEY=replace-with-a-long-random-internal-api-key
FRONTEND_ORIGIN=http://localhost:3000
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

REDIS_PASSWORD=change-me
MEILI_MASTER_KEY=change-me
RABBITMQ_DEFAULT_USER=mytruyen
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_QUEUE_CRAWL=crawl

# Hybrid/Pinecone search is currently disabled, but Settings requires a value.
PINECONE_API_KEY=disabled
