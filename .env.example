# Copy this file to .env for local Docker Compose.
POSTGRES_USER=mytruyen
POSTGRES_PASSWORD=change-me
IDENTITY_POSTGRES_DB=mytruyen_identity
CATALOG_POSTGRES_DB=mytruyen_catalog
ENGAGEMENT_POSTGRES_DB=mytruyen_engagement

# Base64 DER keys: PKCS#8 private key and X.509 public key.
JWT_PRIVATE_KEY_BASE64=replace-with-base64-pkcs8-private-key
JWT_PUBLIC_KEY_BASE64=replace-with-base64-x509-public-key
JWT_ISSUER=mytruyen-auth
JWT_AUDIENCE=mytruyen-api
JWT_ACCESS_SECONDS=900
REFRESH_TOKEN_DAYS=7
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

FRONTEND_ORIGIN=http://localhost:3000
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080
RABBITMQ_MANAGEMENT_PORT=15672
REDIS_PASSWORD=change-me
MEILI_MASTER_KEY=change-me
# Leave blank only for local development. Production must use restricted keys.
MEILI_SEARCH_KEY=
MEILI_WRITE_KEY=
RABBITMQ_DEFAULT_USER=mytruyen
RABBITMQ_DEFAULT_PASS=change-me
# Legacy worker API compatibility is opt-in; book/chapter compatibility is not complete yet.
LEGACY_WORKER_COMPAT_ENABLED=false
# Must match the existing worker's queue exactly; do not use the ingestion skeleton queue.
RABBITMQ_QUEUE_CRAWL=
