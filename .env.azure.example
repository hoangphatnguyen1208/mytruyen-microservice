# Copy to .env.azure (ignored by Git). Never commit real secrets.
DOCKERHUB_USERNAME=
IMAGE_TAG=sha-REPLACE_WITH_FULL_PUBLISHED_COMMIT_SHA
AZURE_PG_HOST=YOUR-SERVER.postgres.database.azure.com
# Existing readable PEM bundle containing current Azure trusted root CAs.
AZURE_PG_CA_FILE=./certs/azure-postgres-ca.pem
# Pre-create mytruyen_identity owned by identity_app and mytruyen_catalog owned by catalog_app.
IDENTITY_DB_PASSWORD=
CATALOG_DB_PASSWORD=
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ISSUER=mytruyen-auth
JWT_AUDIENCE=mytruyen-api
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
FRONTEND_ORIGIN=https://YOUR-FRONTEND-DOMAIN
GATEWAY_PORT=8080
RABBITMQ_DEFAULT_USER=mytruyen
RABBITMQ_DEFAULT_PASS=
# Same broker credentials as above, URL-encoded; Compose internal host, default vhost.
APP_RABBITMQ_URL=amqp://mytruyen:REPLACE_WITH_ENCODED_PASSWORD@rabbitmq:5672/
MEILI_MASTER_KEY=
# Required restricted keys; see runbook for initial offline bootstrap.
MEILI_SEARCH_KEY=
MEILI_WRITE_KEY=
LEGACY_WORKER_COMPAT_ENABLED=false
LEGACY_WORKER_STATUS_MAP={}
RABBITMQ_QUEUE_CRAWL=mytruyen.crawl
MYTRUYEN_EMAIL=
MYTRUYEN_PASSWORD=
METRUYEN_BACKEND=
METRUYEN_EMAIL=
METRUYEN_PASSWORD=
